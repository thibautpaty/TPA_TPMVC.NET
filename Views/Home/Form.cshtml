
@model TPLOCAL1.Models.Formulaire

<!DOCTYPE html>
<html>
<head>
    <title>Formulaire TP HN</title>
    <link rel="stylesheet" href="~/resources/Index.css" />
</head>
<body>

<header>
    <img src="~/resources/GroupeHN.png" class="image" alt="GroupeHN" />
    <h1>Formulaire TP HN avis</h1>
</header>

<nav>
    <ul>
        <li>
            <a href="/">Accueil</a>
        </li>
        <li>
            <a href="/Home/Index/AvisList">Liste avis</a>
        </li>
    </ul>
</nav>

@if (ViewBag.Erreur != null)
{
    <div style="width: 500px; text-align: center;">
        <p style="color: red;">@ViewBag.Erreur</p>
    </div>
}

<section>
    <form action="/Home/ValidationFormulaire" method="post">

        <table>
            <caption>Informations personnelles</caption>
            <tr>
                <td>Nom</td>
                <td>
                    <input type="text" id="LastName" name="LastName" value="@Model?.LastName" />
                </td>
            </tr>
            <tr>
                <td>Prénom</td>
                <td>
                    <input type="text" id="FirstName" name="FirstName" value="@Model?.FirstName" />
                </td>
            </tr>
            <tr>
                <td>Sexe</td>
                <td>
                    <select id="Gender" name="Gender">
                        <option value="">Sélectionner un sexe</option>
                        <option value="Homme" selected="@(Model?.Gender == "Homme")">Homme</option>
                        <option value="Femme" selected="@(Model?.Gender == "Femme")">Femme</option>
                        <option value="Autre" selected="@(Model?.Gender == "Autre")">Autre</option>
                    </select>
                </td>
            </tr>
            <tr>
                <td>Adresse</td>
                <td>
                    <input type="text" id="Address" name="Address" value="@Model?.Address" />
                </td>
            </tr>
            <tr>
                <td>Code Postal</td>
                <td>
                    <input type="text" id="PostalCode" name="PostalCode"
                           pattern="[0-9]{5}" maxlength="5" value="@Model?.PostalCode" />
                </td>
            </tr>
            <tr>
                <td>Ville</td>
                <td>
                    <input type="text" id="City" name="City" value="@Model?.City" />
                </td>
            </tr>
            <tr>
                <td>Adresse mail</td>
                <td>
                    <input type="email" id="Email" name="Email" value="@Model?.Email" />
                </td>
            </tr>
        </table>

        <table>
            <caption>Informations formation suivie</caption>
            <tr>
                <td>Date début formation</td>
                <td>
                    <input type="date" id="StartDate" name="StartDate"
                           max="2020-12-31"
                           value="@(Model != null && Model.StartDate != DateTime.MinValue ? Model.StartDate.ToString("yyyy-MM-dd") : "")" />
                </td>
            </tr>
            <tr>
                <td>Formation suivie</td>
                <td>
                    <select id="TrainingType" name="TrainingType">
                        <option value="">Sélectionner une formation</option>
                        <option value="Formation Cobol" selected="@(Model?.TrainingType == "Formation Cobol")">Formation Cobol</option>
                        <option value="Formation C#" selected="@(Model?.TrainingType == "Formation C#")">Formation C#</option>
                        <option value="Formation à double compétence" selected="@(Model?.TrainingType == "Formation à double compétence")">Formation à double compétence</option>
                    </select>
                </td>
            </tr>
        </table>

        <table>
            <caption>Avis sur la formation</caption>
            <tr>
                <td>Formation Cobol</td>
                <td>
                    <input type="text" id="CobolFormation" name="CobolFormation"
                           value="@Model?.CobolFormation" />
                </td>
            </tr>
            <tr>
                <td>Formation C#</td>
                <td>
                    <input type="text" id="CSharpFormation" name="CSharpFormation"
                           value="@Model?.CSharpFormation" />
                </td>
            </tr>
        </table>

        <button type="submit">Valider</button>
    </form>
</section>

</body>
</html>
