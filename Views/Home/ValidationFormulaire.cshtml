
@model TPLOCAL1.Models.Formulaire

<!DOCTYPE html>
<html>
<head>
    <title>Page de validation</title>
    <link rel="stylesheet" href="~/resources/Index.css" />
</head>
<body>

<header>
    <img src="~/resources/GroupeHN.png" class="image" alt="GroupeHN" />
    <h1>Page de validation</h1>
</header>

<nav>
    <ul>
        <li><a href="/">Accueil</a></li>
        <li><a href="/Home/Index/AvisList">Liste avis</a></li>
    </ul>
</nav>

<section>

    <p>Votre formulaire a bien été pris en compte</p>

    <table>
        <caption>Informations personnelles</caption>
        <tr>
            <td>Nom :</td>
            <td>@Model.LastName</td>
        </tr>
        <tr>
            <td>Prénom :</td>
            <td>@Model.FirstName</td>
        </tr>
        <tr>
            <td>Sexe :</td>
            <td>@Model.Gender</td>
        </tr>
        <tr>
            <td>Adresse :</td>
            <td>@Model.Address</td>
        </tr>
        <tr>
            <td>Code postal :</td>
            <td>@Model.PostalCode</td>
        </tr>
        <tr>
            <td>Ville :</td>
            <td>@Model.City</td>
        </tr>
        <tr>
            <td>E-mail :</td>
            <td>@Model.Email</td>
        </tr>
    </table>

    <table>
        <caption>Informations sur la formation</caption>
        <tr>
            <td>Date de début :</td>
            <td>@Model.StartDate.ToString("dd/MM/yyyy")</td>
        </tr>
        <tr>
            <td>Type de formation :</td>
            <td>@Model.TrainingType</td>
        </tr>
    </table>

    <table>
        <caption>Avis sur la formation</caption>
        <tr>
            <td>Formation Cobol :</td>
            <td>@Model.CobolFormation</td>
        </tr>
        <tr>
            <td>Formation C# :</td>
            <td>@Model.CSharpFormation</td>
        </tr>
    </table>

</section>

</body>
</html>
