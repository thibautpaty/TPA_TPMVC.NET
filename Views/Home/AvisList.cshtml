@model List<TPLOCAL1.Models.Opinion>

<!DOCTYPE html>

<head>
    <title>Liste des avis</title>
    <link rel="stylesheet" href="~/resources/Index.css" />
</head>
<body>

    <header>
        <img src="~/resources/GroupeHN.png" class="image" alt="Logo HN" />
        <h1>Liste des avis</h1>
    </header>

    <nav>
        <ul>
            <li><a href="/">Accueil</a></li>
            <li><a href="/Home/Index/Form">Formulaire</a></li>
        </ul>
    </nav>

    <table>
        <caption>Liste</caption>
        <tr>
            <th>Nom</th>
            <th>Prénom</th>
            <th>Avis donné</th>
        </tr>

        @foreach (var avis in Model)
        {
            <tr>
                <td>@avis.LastName</td>
                <td>@avis.FirstName</td>
                <td style="background-color: @(avis.OpinionGiven == "O" ? "green" : "red"); color: black;">
                    @(avis.OpinionGiven == "O" ? "Oui" : "Non")
                </td>
            </tr>
        }
    </table>

</body>
</html>